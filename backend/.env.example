# MongoDB Atlas or local connection string
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/bookswap?retryWrites=true&w=majority
# Port for the Node.js server (Render defaults to 10000 or sets PORT automatically)
PORT=4000
# 64-byte hex string or secure random string for signing JWT tokens
JWT_SECRET=your_jwt_secret_key_here
NODE_ENV=production
